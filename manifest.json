{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.6",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/core/seletores.js",
        "src/content/leitura-dom.js",
        "src/core/mapeador.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "side_panel": {
    "default_path": "src/popup/popup.html?lateral=1"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Proteu QA — dados de teste, seletores e formulários"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Abrir o Proteu QA"
    },
    "repetir-ultima-geracao": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "Inserir a última geração no campo focado"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
